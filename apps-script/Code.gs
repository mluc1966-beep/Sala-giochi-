/** Sala Giochi — Rebus API v2.14.0
 * 1. Crea una cartella Drive privata con CSV e immagini.
 * 2. Inserisci l'ID della cartella qui sotto.
 * 3. Esegui setupArchive() dall'editor per controllare l'archivio.
 * 4. Distribuisci come app web, accesso: Chiunque (solo se vuoi usare la PWA senza login).
 * Attenzione: le risposte sono trasmesse al browser per consentire la verifica.
 */
const FOLDER_ID = 'INSERISCI_ID_CARTELLA_DRIVE';
const CSV_FILENAME = 'rebus_selected_50.csv';
const HEADERS = ['id','diagram','solution','accepted','firstReading','hint','magazine','year','image'];

function folder_(){if(FOLDER_ID==='INSERISCI_ID_CARTELLA_DRIVE')throw new Error('Configura FOLDER_ID in Code.gs');return DriveApp.getFolderById(FOLDER_ID);}
function fileByName_(folder,name){const it=folder.getFilesByName(name);if(!it.hasNext())throw new Error('File non trovato: '+name);return it.next();}
function records_(){
  const folder=folder_();const csv=fileByName_(folder,CSV_FILENAME).getBlob().getDataAsString('UTF-8').replace(/^\uFEFF/,'');
  const rows=Utilities.parseCsv(csv);if(!rows.length)throw new Error('CSV vuoto');
  const keys=rows.shift().map(x=>String(x).trim());
  ['id','diagram','solution','image'].forEach(k=>{if(!keys.includes(k))throw new Error('Colonna obbligatoria mancante: '+k);});
  const result=rows.filter(r=>r.some(x=>String(x).trim())).map(row=>{
    const o={};keys.forEach((key,i)=>o[key]=String(row[i]||'').trim());
    if(!o.id||!o.solution||!o.image)throw new Error('Riga incompleta: id, solution e image obbligatori');
    return o;
  });
  const ids=result.map(x=>x.id);if(new Set(ids).size!==ids.length)throw new Error('ID duplicati nel CSV');
  return result;
}
function setupArchive(){
  const records=records_(),folder=folder_();
  const missing=records.filter(r=>!folder.getFilesByName(r.image).hasNext()).map(r=>r.image);
  if(missing.length)throw new Error('Immagini mancanti: '+missing.join(', '));
  Logger.log('Archivio valido: '+records.length+' rebus.');
  return records.length;
}
function doGet(e){
  const callback=String((e.parameter||{}).callback||'');
  // Callback generated by the PWA: identifier only, no arbitrary JavaScript.
  if(!/^[$A-Za-z_][$\w]{0,100}$/.test(callback))return ContentService.createTextOutput('Callback non valida');
  let payload;
  try{
    const action=String(e.parameter.action||'');const records=records_();
    if(action==='list'){
      payload={ok:true,records:records.map(r=>({id:r.id,diagram:r.diagram,magazine:r.magazine,year:r.year}))};
    }else if(action==='get'){
      const id=String(e.parameter.id||'');const rec=records.find(r=>r.id===id);
      if(!rec)throw new Error('Rebus inesistente');
      const f=fileByName_(folder_(),rec.image),blob=f.getBlob();
      const mime=blob.getContentType();
      if(!/^image\/(png|jpeg|webp)$/.test(mime))throw new Error('Formato immagine non supportato: '+mime);
      if(blob.getSize()>1800000)throw new Error('Immagine troppo grande (>1,8 MB): '+rec.image);
      payload={ok:true,record:{id:rec.id,diagram:rec.diagram,solution:rec.solution,accepted:rec.accepted?rec.accepted.split('|'):[],firstReading:rec.firstReading,hint:rec.hint,magazine:rec.magazine,year:rec.year,image:'data:'+mime+';base64,'+Utilities.base64Encode(blob.getBytes())}};
    }else throw new Error('Azione sconosciuta');
  }catch(err){payload={ok:false,error:String(err.message||err)};}
  return ContentService.createTextOutput(callback+'('+JSON.stringify(payload)+');').setMimeType(ContentService.MimeType.JAVASCRIPT);
}
